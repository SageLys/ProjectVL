{
  "name": "projectvl",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "魅魔心防战 · 360° 塔防可玩原型（Vite + TypeScript + Canvas 2D）",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run validate:texts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "metrics": "node scripts/computeExperienceMetrics.ts",
    "replay:record": "vite-node scripts/recordGoldenReplay.ts",
    "validate": "vite-node scripts/validateConfig.ts",
    "validate:texts": "vite-node scripts/validateTextsFile.ts",
    "format:config": "vite-node scripts/formatConfig.ts",
    "config:export-xlsx": "vite-node scripts/exportConfigXlsx.ts",
    "config:import-xlsx": "vite-node scripts/importConfigXlsx.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "exceljs": "^4.4.0",
    "happy-dom": "^20.10.6",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
