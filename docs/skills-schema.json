{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:projectvl:skills-schema",
  "title": "ProjectVL 技能卡数据模型",
  "version": "0.4.0",
  "date": "2026-07-12",
  "description": "功能型技能卡与框架机制的概念聚合模型。技能 = 数据 + 通用解释器，禁止每卡硬编码。v0.3.0 新增 passive 常驻修饰；v0.4.0 同步 P4.1 已实现的 Bounty 字段与模型基座数值。economy 在运行时已拆到 src/config/base/economy.json，本 schema 仅保留跨文档概念契约。Bounty/输入数值仍须由 T1/T2/T3 真人与真机校准。",

  "type": "object",
  "required": ["version", "cards", "mechanisms"],
  "properties": {
    "version": { "type": "string" },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/definitions/card" }
    },
    "mechanisms": {
      "type": "object",
      "description": "非卡牌的框架级机制配置：bounty（主动风险选择）与 economy（合成经济骨架，D1–D6 定案值）。",
      "properties": {
        "bounty": { "$ref": "#/definitions/bountyConfig" },
        "economy": { "$ref": "#/definitions/economyConfig" }
      }
    }
  },

  "definitions": {

    "category": {
      "description": "效果原子五大类别。每张卡有唯一主类别（决定图标/配色/教学分组），但其效果可跨类组合原子。",
      "type": "string",
      "enum": ["projectile", "control", "domain", "economy", "defense"]
    },

    "trigger": {
      "description": "触发器库。装备态效果必须绑定到其一。运行时对应 GameEvent 总线的扩展（现有 waveStart/breakthrough/collected 等事件即雏形）。",
      "type": "string",
      "enum": [
        "onFire",
        "onHit",
        "onKill",
        "onWaveStart",
        "onBreach",
        "onPickup",
        "interval",
        "onMerge",
        "passive"
      ]
    },

    "triggerNotes": {
      "description": "（文档性质，非数据字段）各触发器的时机与上下文载荷。",
      "onFire": "炮台发射一发子弹时。上下文: bullet。用于修饰弹道（pierce/split/status 附着等）。",
      "onHit": "子弹命中敌人时。上下文: bullet, enemy, hitPoint。用于连锁、灼烧区、施加状态。",
      "onKill": "敌人死亡时。上下文: enemy, killPoint。用于掉落、扩散、处决联动。",
      "onWaveStart": "波次开始时。上下文: wave。用于护盾回填、召唤诱饵、空投掉落。",
      "onBreach": "敌人突破触及炮台时。上下文: enemy, damage。用于突破减免、反伤。",
      "onPickup": "玩家点击拾取地面掉落时。上下文: drop。经济类联动。",
      "interval": "固定周期。参数: seconds。3★ 形态（雷暴/新星/脉冲光环）的主要载体。",
      "onMerge": "卡牌合成完成时。上下文: cardType, resultStar。合成规则类效果的载体。",
      "passive": "（v0.3.0 新增）常驻修饰，无事件时机。解释器聚合读取：经济乘数/防御修饰/换形/常驻光环/mergeRule。"
    },

    "atom": {
      "description": "效果原子。正交设计：原子只描述『做什么』，由所在上下文（装备触发绑定 / 消耗落点释放）决定『何时何地』。同一原子可同时服务装备态与消耗态——这是一卡两用不膨胀的关键。",
      "type": "string",
      "enum": [
        "pierce", "chain", "split", "ricochet", "aoeOnHit", "beamMorph", "mortarMorph",
        "slow", "freeze", "stun", "knockback", "taunt", "vulnerable",
        "aura", "groundZone", "dot", "summon",
        "dropRateMul", "dropLifetimeMul", "xpMul", "extraDrop", "expiryConvert", "mergeRule", "mergePulse",
        "shield", "thorns", "breachReduction", "novaOnBreak", "execute",
        "burstDamage", "focusPriority"
      ]
    },

    "atomCatalog": {
      "description": "（文档性质）原子分类与参数约定。参数名在 effect.params 中使用。",
      "projectile": {
        "pierce": { "params": ["count", "damageRetention", "rampPerPierce?"], "note": "子弹穿透 count 个敌人" },
        "chain": { "params": ["bounces", "damageRetention", "searchRange"], "note": "命中后向附近敌人弹跳" },
        "split": { "params": ["count", "damageRatio"], "note": "命中后分裂子弹片" },
        "ricochet": { "params": ["bounces"], "note": "撞场地边缘反弹（首批卡未用，原子保留）" },
        "aoeOnHit": { "params": ["radius", "damageRatio", "falloff?"], "note": "命中点小范围爆炸" },
        "beamMorph": { "params": ["interval", "width", "damageRatio"], "note": "3★形态：主炮换形为贯穿光束" },
        "mortarMorph": { "params": ["radius", "damageRatio", "falloff"], "note": "3★形态：主炮换形为抛射榴弹" }
      },
      "control": {
        "slow": { "params": ["ratio", "duration"], "note": "减速" },
        "freeze": { "params": ["duration", "stacksToTrigger?"], "note": "冻结（不可动）" },
        "stun": { "params": ["duration", "chance?"], "note": "眩晕" },
        "knockback": { "params": ["distance", "collisionDamage?"], "note": "击退" },
        "taunt": { "params": ["radius", "priorityWeight"], "note": "嘲讽：改变敌人索敌目标" },
        "vulnerable": { "params": ["ratio", "duration"], "note": "易伤：受到伤害提高" }
      },
      "domain": {
        "aura": { "params": ["radiusRatioOfRange", "effects[]", "tickInterval?"], "note": "以炮台为中心的持续光环，内嵌其他原子" },
        "groundZone": { "params": ["radius", "duration", "tickInterval", "effects[]", "shape?"], "note": "地面区域（点/环带），内嵌 dot/slow 等原子" },
        "dot": { "params": ["damagePerTick", "tickInterval", "duration"], "note": "持续伤害，通常内嵌于 groundZone/aura" },
        "summon": { "params": ["kind(decoy|mirrorTurret|orbital)", "count", "hp", "duration?", "behaviors[]"], "note": "召唤物：诱饵图腾/镜像炮台/环绕球" }
      },
      "economy": {
        "dropRateMul": { "params": ["mul"], "note": "掉率乘数" },
        "dropLifetimeMul": { "params": ["mul"], "note": "地面掉落时限乘数" },
        "xpMul": { "params": ["mul"], "note": "经验乘数" },
        "extraDrop": { "params": ["count", "starWeights", "at(point|turret|killPoint)"], "note": "直接产生掉落" },
        "expiryConvert": { "params": ["ratio", "convertTo(xp)"], "note": "过期掉落按比例转化，突破『过期即损失』" },
        "mergeRule": { "params": ["rule(wildcardDrop|refundChance)", "value"], "note": "改变合成规则本身（触碰 P4 掉落经济学，需建模）" },
        "mergePulse": { "params": ["damagePerMergeCount", "radius(all|value)"], "note": "合成动作产生战斗效果" }
      },
      "defense": {
        "shield": { "params": ["absorbHits", "regenSeconds?"], "note": "炮台护盾，按可吸收突破次数计（P4 可改为数值）" },
        "thorns": { "params": ["ratio"], "note": "反伤" },
        "breachReduction": { "params": ["ratio"], "note": "突破惩罚减免" },
        "novaOnBreak": { "params": ["damage", "knockbackDistance"], "note": "护盾破裂时爆发新星" },
        "execute": { "params": ["hpThresholdRatio"], "note": "低于血线直接处决" }
      },
      "shared": {
        "burstDamage": { "params": ["damageMul", "radius"], "note": "即时范围伤害，消耗态常用" },
        "focusPriority": { "params": ["priorityWeight"], "note": "改变炮台索敌优先级（bounty/烙印联动）" }
      }
    },

    "effect": {
      "type": "object",
      "required": ["atom"],
      "properties": {
        "atom": { "$ref": "#/definitions/atom" },
        "params": { "type": "object", "description": "参数见 atomCatalog。数值占位，P4 标定。" }
      },
      "additionalProperties": false
    },

    "binding": {
      "description": "装备态效果绑定：触发器 + 效果原子列表。",
      "type": "object",
      "required": ["trigger", "effects"],
      "properties": {
        "trigger": { "$ref": "#/definitions/trigger" },
        "triggerParams": { "type": "object", "description": "如 interval 的 { seconds }" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/effect" } }
      },
      "additionalProperties": false
    },

    "starTier": {
      "description": "星级质变模板（硬规则 R5，v0.2.0）：1★=素材/即时，不可装备，故无装备态条目；2★=core 机制成形（基础机制+1 个修饰符，首次装备体验）；3★=transform 形态变换（可整体替换绑定，如换形/领域化/召唤物化）。",
      "type": "object",
      "required": ["tier", "equip"],
      "properties": {
        "tier": { "type": "string", "enum": ["core", "transform"] },
        "equip": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/binding" },
          "description": "装备态：持续规则改变。"
        }
      },
      "additionalProperties": false
    },

    "consumableTier": {
      "description": "消耗态（一卡两用硬规则 R1–R4 见设计表）：同一幻想的压缩即时版。placement 恒为 point（释放点=落点，落点是效果的空间锚点——中心或方向轴，由原子语义决定）。即时生效或持续 ≤5s，禁止永久效果。",
      "type": "object",
      "required": ["effects"],
      "properties": {
        "radius": { "type": "number", "description": "作用半径（px 占位单位），随星级增长" },
        "duration": { "type": "number", "maximum": 5, "description": "持续秒数；省略=即时" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/effect" } }
      },
      "additionalProperties": false
    },

    "card": {
      "type": "object",
      "required": ["id", "category", "textKey", "teaching", "stars", "consumable"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "category": { "$ref": "#/definitions/category" },
        "textKey": {
          "type": "string",
          "description": "题材解耦（P0-5）：卡名/描述/皮肤文案一律经 texts.json 索引，设计表中的中文名仅为工作名。"
        },
        "teaching": {
          "type": "boolean",
          "description": "教学卡标记（硬规则 R7）：true 的卡 2★ 装备态只允许 1 个核心原子（修饰可省），1★ 消耗态效果因果必须一眼可见。"
        },
        "stars": {
          "description": "仅 2★/3★ 有装备态（入装门槛 2★，D3）。1★ 无装备态：定位为合成素材+即时消耗，其消耗态在 consumable.byStar.1 定义。",
          "type": "object",
          "required": ["2", "3"],
          "properties": {
            "2": { "$ref": "#/definitions/starTier" },
            "3": { "$ref": "#/definitions/starTier" }
          },
          "additionalProperties": false
        },
        "consumable": {
          "type": "object",
          "required": ["placement", "byStar"],
          "properties": {
            "placement": { "type": "string", "enum": ["point"] },
            "byStar": {
              "type": "object",
              "required": ["1", "2", "3"],
              "properties": {
                "1": { "$ref": "#/definitions/consumableTier" },
                "2": { "$ref": "#/definitions/consumableTier" },
                "3": { "$ref": "#/definitions/consumableTier" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "implementationBatch": {
          "type": "integer",
          "enum": [1, 2],
          "description": "P5 全量 12 张范围内的实现顺序标签；不表示交付范围边界。"
        },
        "designNotes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "economyConfig": {
      "description": "合成经济骨架（P4 v2；基座采用方案B锁定即装备，共享10格锁3；方案A 7+3 仅作variant对照）。",
      "type": "object",
      "required": ["maxStar", "mergeCopies", "equipThreshold", "equipMode", "handSlots", "equipSlots", "maxLocked", "dropPool", "dropTargeting"],
      "properties": {
        "maxStar": { "type": "integer", "const": 3, "description": "D1：最高星级 3★（4★ 仿真否决：首件@31 拾取；N=60 上限与定向权重×2 下复检维持；若 P4 定向保底比 ×2 更激进须回检）" },
        "mergeCopies": { "type": "integer", "const": 2, "description": "D2：二合（2 张同型同星→+1 星；3★=4 张同型。三合否决：合成 8.8 次/局击穿 KPI ≥16）" },
        "equipThreshold": { "type": "integer", "const": 2, "description": "D3：2★ 起可装备；1★=素材/即时消耗（经济上门槛无差异，体验+内容效率定案）" },
        "equipMode": { "type": "string", "const": "lock", "description": "2026-07-12 暂定方案B：锁定即装备" },
        "handSlots": { "type": "integer", "const": 10, "description": "P4复检基座：装备与库存共享10格；与方案A手牌7+装备3的容量近似等效" },
        "equipSlots": { "type": "integer", "const": 0, "description": "方案B无独立装备栏；方案A由equip-slots variant覆盖为3" },
        "maxLocked": { "type": "integer", "const": 3, "description": "最多3张锁定卡同时作为装备生效" },
        "inRunSlotExpansion": { "type": "boolean", "const": false, "description": "D4：局内不可扩容（+1 格即显著改变成型率，会成必选强度）；配置保留，P5 后可作 perk 实验" },
        "equipDistinctTypes": { "type": "boolean", "const": true, "description": "D6：装备栏同类型唯一" },
        "feedEquipped": { "type": "boolean", "const": true, "description": "D6：喂养合成——手牌卡与已装备同型同星直接合成升星（免卸装；砍掉≈手牌 −1 格）" },
        "dropPool": {
          "type": "object",
          "description": "P4 v2：目录规模与单局有效池解耦。P5目录12张，但每局基础掉落池仅5张，避免12类等权使指定3★期望升至48掉落。",
          "required": ["catalogSize", "activePoolSize", "selection"],
          "properties": {
            "catalogSize": { "type": "integer", "const": 12 },
            "activePoolSize": { "type": "integer", "const": 5 },
            "selection": { "type": "string", "const": "run-loadout" }
          },
          "additionalProperties": false
        },
        "dropTargeting": {
          "type": "object",
          "description": "差一张保底：某类型首张3★恰缺1份时提高该类型权重；已有同型3★后停止定向。",
          "required": ["enabled", "nearCompletionWeight"],
          "properties": {
            "enabled": { "type": "boolean", "const": true },
            "nearCompletionWeight": { "type": "number", "const": 2.25 }
          },
          "additionalProperties": false
        },
        "dropStarPolicy": {
          "type": "object",
          "description": "D5：普通掉落一律 1★；2★ 仅经 bounty/Boss/经济卡（占总量 ~5% [P4]）；3★ 永不直掉",
          "properties": {
            "normal": { "type": "integer", "const": 1 },
            "bossStar2Chance": { "type": "number", "const": 1 },
            "bountyBossMax": { "type": "integer", "const": 2 },
            "star2Share": { "type": "number", "const": 0.05, "description": "P4/P4.1 基座 0.05；Bounty 奖励再乘 starWeightShift" }
          }
        },
        "pickupBudgetTarget": { "type": "object", "description": "[P4] 选定的设计锚（非推导结果）：有效拾取 38–45 次/局（依据=点击物理上限×单局时长×注意力预算）→ 掉落生成 48–56（过期≤20%）→ 反推 dropChance（占位 0.25–0.33）。T2 实测出窗则连带复核 D4 与溢出3★结论", "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } } }
      },
      "additionalProperties": false
    },

    "bountyConfig": {
      "description": "精英 Bounty：主动风险选择机制（框架级，非卡牌）。险区掉落原则内置：赏金掉落『肥而急』。点击精英=接单，与点掉落/拖卡释放争夺同一注意力。接单是可选项：不接单无惩罚（精英按普通强敌行为），接单后精英狂暴但死后掉肥赏金——风险为 opt-in，避免伪选择。",
      "type": "object",
      "required": ["enabled", "enabledFromWave", "spawnChancePerWave", "markWindowSeconds", "hitRadiusPadding", "acceptEffects", "rewards"],
      "properties": {
        "enabled": { "type": "boolean", "description": "机制总开关；P4.1 基座 true" },
        "enabledFromWave": { "type": "integer", "description": "P4.1 基座 3" },
        "spawnChancePerWave": { "type": "number", "description": "每波至多一名；P4.1 基座 0.55" },
        "markWindowSeconds": { "type": "number", "description": "可接单窗口；P4.1 基座 8 秒，以倒计时环呈现" },
        "hitRadiusPadding": { "type": "number", "description": "敌人视觉半径外附加命中热区；P4.1 基座 12px，仍待 T1 真机校准" },
        "acceptEffects": {
          "type": "object",
          "required": ["focusFire", "enrage"],
          "properties": {
            "focusFire": { "type": "boolean", "description": "接单后炮台索敌优先级：bounty > 烙印(vulnerable标记) > 最近敌人" },
            "enrage": {
              "type": "object",
              "description": "接单后精英狂暴；标准档 P4.1 基座 speedMul=1.35 / hpMul=10，可由难度 variant 覆盖。",
              "required": ["speedMul", "hpMul"],
              "properties": {
                "speedMul": { "type": "number", "exclusiveMinimum": 0 },
                "hpMul": { "type": "number", "exclusiveMinimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "rewards": {
          "type": "object",
          "required": ["dropCount", "starWeightShift", "dropLifetimeMul"],
          "properties": {
            "dropCount": { "type": "integer", "description": "P4.1 基座 2 张" },
            "starWeightShift": { "type": "number", "description": "P4.1 基座 3（2★ 概率 ×3；仍受星级上限约束）" },
            "dropLifetimeMul": { "type": "number", "description": "P4.1 基座 0.6，形成『肥而急』" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
