{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:projectvl:skills-schema",
  "title": "ProjectVL 技能卡数据模型",
  "version": "0.4.0",
  "date": "2026-07-12",
  "description": "v0.4.0 技能卡数据模型。35 张正式卡全部通过 evolutionTree 解析 3/4/5/6★；recipeOnly 产物没有进化树，只声明 6★ 终态。技能行为只由 JSON 触发器与效果原子组成。",
  "type": "object",
  "required": [
    "version",
    "cards",
    "mechanisms"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/card"
      }
    },
    "mechanisms": {
      "type": "object",
      "description": "非卡牌的框架级机制配置：bounty（主动风险选择）与 economy（合成经济骨架，D1–D6 定案值）。",
      "properties": {
        "bounty": {
          "$ref": "#/definitions/bountyConfig"
        },
        "economy": {
          "$ref": "#/definitions/economyConfig"
        }
      }
    }
  },
  "definitions": {
    "category": {
      "description": "效果原子五大类别。每张卡有唯一主类别（决定图标/配色/教学分组），但其效果可跨类组合原子。",
      "type": "string",
      "enum": [
        "projectile",
        "control",
        "domain",
        "economy",
        "defense"
      ]
    },
    "trigger": {
      "description": "触发器库。装备态效果必须绑定到其一。运行时对应 GameEvent 总线的扩展（现有 waveStart/breakthrough/collected 等事件即雏形）。",
      "type": "string",
      "enum": [
        "onFire",
        "onHit",
        "onKill",
        "onWaveStart",
        "onBreach",
        "onPickup",
        "interval",
        "onMerge",
        "passive"
      ]
    },
    "triggerNotes": {
      "description": "（文档性质，非数据字段）各触发器的时机与上下文载荷。",
      "onFire": "炮台发射一发子弹时。上下文: bullet。用于修饰弹道（pierce/split/status 附着等）。",
      "onHit": "子弹命中敌人时。上下文: bullet, enemy, hitPoint。用于连锁、灼烧区、施加状态。",
      "onKill": "敌人死亡时。上下文: enemy, killPoint。用于掉落、扩散、处决联动。",
      "onWaveStart": "波次开始时。上下文: wave。用于护盾回填、召唤诱饵、空投掉落。",
      "onBreach": "敌人突破触及炮台时。上下文: enemy, damage。用于突破减免、反伤。",
      "onPickup": "玩家点击拾取地面掉落时。上下文: drop。经济类联动。",
      "interval": "固定周期。参数: seconds。3★ 形态（雷暴/新星/脉冲光环）的主要载体。",
      "onMerge": "卡牌合成完成时。上下文: cardType, resultStar。合成规则类效果的载体。",
      "passive": "（v0.3.0 新增）常驻修饰，无事件时机。解释器聚合读取：经济乘数/防御修饰/换形/常驻光环/mergeRule。"
    },
    "atom": {
      "description": "效果原子。正交设计：原子只描述『做什么』，由所在上下文（装备触发绑定 / 消耗落点释放）决定『何时何地』。同一原子可同时服务装备态与消耗态——这是一卡两用不膨胀的关键。",
      "type": "string",
      "enum": [
        "pierce",
        "chain",
        "split",
        "ricochet",
        "aoeOnHit",
        "beamMorph",
        "mortarMorph",
        "slow",
        "freeze",
        "stun",
        "knockback",
        "taunt",
        "vulnerable",
        "aura",
        "groundZone",
        "dot",
        "summon",
        "dropRateMul",
        "dropLifetimeMul",
        "xpMul",
        "extraDrop",
        "expiryConvert",
        "mergeRule",
        "mergePulse",
        "shield",
        "thorns",
        "breachReduction",
        "novaOnBreak",
        "execute",
        "burstDamage",
        "focusPriority",
        "restore",
        "statBuff"
      ]
    },
    "atomCatalog": {
      "description": "（文档性质）原子分类与参数约定。参数名在 effect.params 中使用。",
      "projectile": {
        "pierce": {
          "params": [
            "count",
            "damageRetention",
            "rampPerPierce?"
          ],
          "note": "子弹穿透 count 个敌人"
        },
        "chain": {
          "params": [
            "bounces",
            "damageRetention",
            "searchRange"
          ],
          "note": "命中后向附近敌人弹跳"
        },
        "split": {
          "params": [
            "count",
            "damageRatio"
          ],
          "note": "命中后分裂子弹片"
        },
        "ricochet": {
          "params": [
            "bounces"
          ],
          "note": "撞场地边缘反弹（首批卡未用，原子保留）"
        },
        "aoeOnHit": {
          "params": [
            "radius",
            "damageRatio",
            "falloff?"
          ],
          "note": "命中点小范围爆炸"
        },
        "beamMorph": {
          "params": [
            "interval",
            "width",
            "damageRatio"
          ],
          "note": "3★形态：主炮换形为贯穿光束"
        },
        "mortarMorph": {
          "params": [
            "radius",
            "damageRatio",
            "falloff"
          ],
          "note": "3★形态：主炮换形为抛射榴弹"
        }
      },
      "control": {
        "slow": {
          "params": [
            "ratio",
            "duration"
          ],
          "note": "减速"
        },
        "freeze": {
          "params": [
            "duration",
            "stacksToTrigger?"
          ],
          "note": "冻结（不可动）"
        },
        "stun": {
          "params": [
            "duration",
            "chance?"
          ],
          "note": "眩晕"
        },
        "knockback": {
          "params": [
            "distance",
            "collisionDamage?"
          ],
          "note": "击退"
        },
        "taunt": {
          "params": [
            "radius",
            "priorityWeight"
          ],
          "note": "嘲讽：改变敌人索敌目标"
        },
        "vulnerable": {
          "params": [
            "ratio",
            "duration",
            "maxStacks?"
          ],
          "note": "易伤：受到伤害提高；maxStacks>1 时按 ratio 逐次叠加并封顶"
        }
      },
      "domain": {
        "aura": {
          "params": [
            "radiusRatioOfRange",
            "effects[]",
            "tickInterval?"
          ],
          "note": "以炮台为中心的持续光环，内嵌其他原子"
        },
        "groundZone": {
          "params": [
            "radius",
            "duration",
            "tickInterval",
            "effects[]",
            "shape?"
          ],
          "note": "地面区域（点/环带），内嵌 dot/slow 等原子"
        },
        "dot": {
          "params": [
            "damagePerTick",
            "tickInterval",
            "duration"
          ],
          "note": "持续伤害，通常内嵌于 groundZone/aura"
        },
        "summon": {
          "params": [
            "kind(decoy|mirrorTurret|orbital)",
            "count",
            "hp",
            "duration?",
            "behaviors[]",
            "replacesEarlier?"
          ],
          "note": "召唤物：诱饵图腾/镜像炮台/环绕球；进化变形可声明替换同卡更早召唤"
        }
      },
      "economy": {
        "dropRateMul": {
          "params": [
            "mul"
          ],
          "note": "掉率乘数"
        },
        "dropLifetimeMul": {
          "params": [
            "mul"
          ],
          "note": "地面掉落时限乘数"
        },
        "xpMul": {
          "params": [
            "mul"
          ],
          "note": "经验乘数"
        },
        "extraDrop": {
          "params": [
            "count",
            "starWeights",
            "at(point|turret|killPoint)"
          ],
          "note": "直接产生掉落"
        },
        "expiryConvert": {
          "params": [
            "ratio",
            "convertTo(xp)"
          ],
          "note": "过期掉落按比例转化，突破『过期即损失』"
        },
        "mergeRule": {
          "params": [
            "rule(wildcardDrop|refundChance)",
            "value"
          ],
          "note": "改变合成规则本身（触碰 P4 掉落经济学，需建模）"
        },
        "mergePulse": {
          "params": [
            "damagePerMergeCount",
            "radius(all|value)"
          ],
          "note": "合成动作产生战斗效果"
        }
      },
      "defense": {
        "shield": {
          "params": [
            "absorbHits",
            "regenSeconds?"
          ],
          "note": "炮台护盾，按可吸收突破次数计（P4 可改为数值）"
        },
        "thorns": {
          "params": [
            "ratio"
          ],
          "note": "反伤"
        },
        "breachReduction": {
          "params": [
            "ratio"
          ],
          "note": "突破惩罚减免"
        },
        "novaOnBreak": {
          "params": [
            "damage",
            "knockbackDistance"
          ],
          "note": "护盾破裂时爆发新星"
        },
        "execute": {
          "params": [
            "hpThresholdRatio"
          ],
          "note": "低于血线直接处决"
        }
      },
      "shared": {
        "burstDamage": {
          "params": [
            "damageMul",
            "radius"
          ],
          "note": "即时范围伤害，消耗态常用"
        },
        "focusPriority": {
          "params": [
            "priorityWeight"
          ],
          "note": "改变炮台索敌优先级（bounty/烙印联动）"
        },
        "restore": {
          "params": [
            "amount?",
            "amountRatio?"
          ],
          "note": "回复炮台 HP，amount 与 maxHp×amountRatio 相加并封顶 maxHp"
        },
        "statBuff": {
          "params": [
            "stat",
            "operation(add|mul)",
            "value",
            "duration",
            "maxStacks?"
          ],
          "note": "压入限时 RuntimeStatModifier；同来源同属性按 maxStacks 限制层数"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "atom"
      ],
      "properties": {
        "atom": {
          "$ref": "#/definitions/atom"
        },
        "params": {
          "type": "object",
          "description": "参数见 atomCatalog。数值占位，P4 标定。"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "description": "装备态效果绑定：触发器 + 效果原子列表。",
      "type": "object",
      "required": [
        "trigger",
        "effects"
      ],
      "properties": {
        "trigger": {
          "$ref": "#/definitions/trigger"
        },
        "triggerParams": {
          "type": "object",
          "description": "如 interval 的 { seconds }"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/effect"
          }
        }
      },
      "additionalProperties": false
    },
    "starTier": {
      "description": "星级质变模板（硬规则 R5，v0.4.0，2026-07-12 人工定案 6★ 上限/3★ 入装后重构）：1★=素材/即时、2★=进阶素材（均不可装备，无装备态条目）；3★=core 机制成形（基础机制+1 修饰，首次装备体验，入装门槛）；4★=amplify 数值放大（不单独定义装备态，由 card.amplifyAxis 对 3★ 结构生成）；5★=dual 第二机制（core 之上叠加正交机制）；6★=transform 形态变换（可整体替换绑定：换形/领域化/召唤物化）。",
      "type": "object",
      "required": [
        "tier",
        "equip"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "core",
            "dual",
            "transform"
          ]
        },
        "equip": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/binding"
          },
          "description": "装备态：持续规则改变。"
        }
      },
      "additionalProperties": false
    },
    "consumableTier": {
      "description": "消耗态（一卡两用硬规则 R1–R4 见设计表）：同一幻想的压缩即时版。placement 恒为 point（释放点=落点，落点是效果的空间锚点——中心或方向轴，由原子语义决定）。即时生效或持续 ≤5s，禁止永久效果。",
      "type": "object",
      "required": [
        "effects"
      ],
      "properties": {
        "radius": {
          "type": "number",
          "description": "作用半径（px 占位单位），随星级增长"
        },
        "duration": {
          "type": "number",
          "maximum": 5,
          "description": "持续秒数；省略=即时"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/effect"
          }
        }
      },
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "category",
        "textKey",
        "teaching",
        "stars",
        "amplifyAxis",
        "consumable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "category": {
          "$ref": "#/definitions/category"
        },
        "textKey": {
          "type": "string",
          "description": "题材解耦（P0-5）：卡名/描述/皮肤文案一律经 texts.json 索引，设计表中的中文名仅为工作名。"
        },
        "teaching": {
          "type": "boolean",
          "description": "教学卡标记（硬规则 R7）：true 的卡 3★ 装备态只允许 1 个核心原子（修饰可省），1★ 消耗态效果因果必须一眼可见。"
        },
        "stars": {
          "description": "正式卡保留 3★/5★/6★ 迁移锚点并由 evolutionTree 实际解析；recipeOnly 产物只声明 6★ 终态。",
          "type": "object",
          "required": ["6"],
          "properties": {
            "3": {
              "$ref": "#/definitions/starTier"
            },
            "5": {
              "$ref": "#/definitions/starTier"
            },
            "6": {
              "$ref": "#/definitions/starTier"
            }
          },
          "additionalProperties": false
        },
        "amplifyAxis": {
          "description": "4★ 放大轴（R1/R5）：对 3★ 装备态同构应用的参数增量，无新机制。值为字符串增量表达（如 \"+1\"、\"+20\"、\"+25%\"）。",
          "type": "object",
          "required": [
            "params"
          ],
          "properties": {
            "description": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "consumable": {
          "type": "object",
          "required": [
            "placement",
            "anchors"
          ],
          "properties": {
            "placement": {
              "type": "string",
              "enum": [
                "point"
              ]
            },
            "anchors": {
              "description": "消耗态锚点：1★/3★/6★ 单独设计；2★/4★/5★ 按 interpolation 规则数值内插（5★ ≈ 6★ 数值 ~80%，不含换形/终极元素）。",
              "type": "object",
              "required": [
                "1",
                "3",
                "6"
              ],
              "properties": {
                "1": {
                  "$ref": "#/definitions/consumableTier"
                },
                "3": {
                  "$ref": "#/definitions/consumableTier"
                },
                "6": {
                  "$ref": "#/definitions/consumableTier"
                }
              },
              "additionalProperties": false
            },
            "interpolation": {
              "type": "string",
              "enum": [
                "linear"
              ],
              "default": "linear"
            }
          },
          "additionalProperties": false
        },
        "implementationBatch": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "1 = P5 首批实装子集；2 = 已完成设计的二批储备。"
        },
        "designNotes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "economyConfig": {
      "description": "合成经济骨架（v0.4.0）：标【定案】的为 2026-07-12 人工定案（优先级高于一切仿真结论）；标【占位】的为原 D 系列沿用假设（原 P4前置结论已随回退作废，其数值真伪待数值重标定阶段按 P6 人在环路方法复核）。",
      "type": "object",
      "required": [
        "maxStar",
        "mergeCopies",
        "mergeCopiesWhenTwoCopyDisabled",
        "equipThreshold",
        "handSlots",
        "equipSlots",
        "equipIrreversible",
        "unequipPolicy",
        "placeholderAssumptions"
      ],
      "properties": {
        "maxStar": {
          "type": "integer",
          "const": 6,
          "description": "【定案】最高星级 6★（人工拍板，推翻原 D1=3★）。6★ 单局可达性为数值重标定第一优先级问题：可达目标须人工拍板后反推掉落量级/活跃池/定向保底。"
        },
        "mergeCopies": {
          "type": "integer",
          "const": 2,
          "description": "【占位】二合（2 张同型同星→+1 星）。成本链：2★=2 / 3★=4（入装）/ 4★=8 / 5★=16 / 6★=32 张同型 1★ 等价。原三合否决论据已失效，若重标定中二合导致 6★ 不可达且不接受长线定位，可回开三合讨论。"
        },
        "mergeCopiesWhenTwoCopyDisabled": {
          "type": "integer",
          "minimum": 2,
          "description": "关闭二合占位假设时采用的备选合成份数。"
        },
        "equipThreshold": {
          "type": "integer",
          "const": 3,
          "description": "【定案】3★ 起可装备（人工拍板，推翻原 D3=2★）；1–2★=素材/即时消耗。"
        },
        "handSlots": {
          "type": "integer",
          "const": 7,
          "description": "【占位】手牌 7 格。原 D4 默认值级别；6★ 合成链更长、囤卡压力更大，重标定必查。"
        },
        "equipSlots": {
          "type": "integer",
          "const": 3,
          "description": "方案A独立装备 3 格；装备卡可从装备栏拖到战场消耗释放。"
        },
        "inRunSlotExpansion": {
          "type": "boolean",
          "const": false,
          "description": "【占位】局内不可扩容；配置保留可作 perk 实验。"
        },
        "equipDistinctTypes": {
          "type": "boolean",
          "const": true,
          "description": "【占位】装备栏同类型唯一（原 D6）。"
        },
        "feedEquipped": {
          "type": "boolean",
          "const": true,
          "description": "【占位】喂养合成：手牌卡与已装备同型同星直接合成升星。"
        },
        "placeholderAssumptions": {
          "type": "object",
          "description": "四项可翻转的占位假设开关；默认均为 true 以维持当前行为。",
          "required": ["twoCopyMerge", "normalDropsOnlyOneStar", "feedEquipped", "distinctEquippedTypes"],
          "properties": {
            "twoCopyMerge": { "type": "boolean" },
            "normalDropsOnlyOneStar": { "type": "boolean" },
            "feedEquipped": { "type": "boolean" },
            "distinctEquippedTypes": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "dropStarPolicy": {
          "type": "object",
          "description": "【占位】普通掉落一律 1★；2★ 仅经 bounty/Boss/经济卡（占总量 ~5%）；3★ 及以上永不直掉。",
          "properties": {
            "normal": {
              "type": "integer",
              "const": 1
            },
            "bountyBossMax": {
              "type": "integer",
              "const": 2
            },
            "star2Share": {
              "type": "number",
              "description": "占位 0.05"
            }
          }
        },
        "pickupBudgetTarget": {
          "type": "object",
          "description": "【失效待重定】原锚\"有效拾取 38–45 次/局\"基于 3★ 上限与旧波次密度，已双重失效（6★ 定案 + P6 体验重标定将大改敌人/掉落密度）。新锚由 P6 手感基线 + 6★ 可达性目标共同反推。",
          "properties": {
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        },
